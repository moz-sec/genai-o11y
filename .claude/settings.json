{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; [ -n \"$f\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/scripts/lint.sh\" \"$f\" >&2 || exit 2"
          }
        ]
      }
    ]
  }
}
