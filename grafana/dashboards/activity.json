{
  "uid": "genai-activity",
  "title": "GenAI Activity",
  "description": "Tool calls, API errors and latency, traces, and a sanitization check.",
  "tags": [
    "genai-o11y"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({job=~\"claude-code|codex.*\"}, service_name)",
          "refId": "service-var"
        },
        "definition": "label_values({job=~\"claude-code|codex.*\"}, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({job=~\"claude-code|codex.*\", model!=\"\"}, model)",
          "refId": "model-var"
        },
        "definition": "label_values({job=~\"claude-code|codex.*\", model!=\"\"}, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "genai-o11y",
      "type": "dashboards",
      "tags": [
        "genai-o11y"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Tools",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tool calls by tool and result",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (tool_name, success) (count_over_time({service_name=~\"$service\"} | event_name=~\"tool_result|codex.tool_result\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{tool_name}} success={{success}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tool duration p50 / p95",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.5, {service_name=~\"$service\"} | event_name=~\"tool_result|codex.tool_result\" | unwrap duration_ms [$__auto]) by (tool_name)",
          "queryType": "range",
          "legendFormat": "p50 {{tool_name}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "quantile_over_time(0.95, {service_name=~\"$service\"} | event_name=~\"tool_result|codex.tool_result\" | unwrap duration_ms [$__auto]) by (tool_name)",
          "queryType": "range",
          "legendFormat": "p95 {{tool_name}}",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "API",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API errors by status code",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (status_code) (count_over_time({service_name=~\"$service\"} | event_name=~\"api_error|codex.api_error\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{status_code}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API latency p95",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {service_name=~\"$service\"} | event_name=~\"api_request|codex.api_request\" | model=~\"$model\" | unwrap duration_ms [$__auto]) by (model)",
          "queryType": "range",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Traces and privacy",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"$service\" }",
          "limit": 50,
          "tableType": "traces",
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Click a trace ID to open it."
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Sanitization leaks",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "expr": "(sum(count_over_time({service_name=~\".+\"} |~ \"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}\" [$__range])) or vector(0)) + (sum(count_over_time({service_name=~\".+\"} | prompt!=\"\" or prompt_text!=\"\" or tool_parameters!=\"\" or tool_input!=\"\" or arguments!=\"\" or output!=\"\" or error!=\"\" or user_email!=\"\" or user_account_uuid!=\"\" or user_account_id!=\"\" or user_id!=\"\" or organization_id!=\"\" or host_name!=\"\" or host_id!=\"\" [$__range])) or vector(0))",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Log lines in the selected range that contain an email address or an attribute that the strict profile removes. Only meaningful with PROFILE=strict: standard keeps some of these attributes on purpose. verify.sh with PROFILE=standard also writes fake values that show up here.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    }
  ]
}
