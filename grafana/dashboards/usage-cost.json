      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_active_time_seconds_total{service_name=~\"$service\"}[$__range] anchored))",
          "legendFormat": "{{type}}",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "user: time you typed; cli: time the agent worked.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
